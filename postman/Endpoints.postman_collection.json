{
	"info": {
		"_postman_id": "1d7d64ed-9f14-4e81-bfd8-3629a7c7a3c4",
		"name": "Endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "21045697"
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/health",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"health"
					]
				}
			},
			"response": []
		},
		{
			"name": "Generate API Key",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/api-keys?partner_name={{PARTNER_NAME}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"api-keys"
					],
					"query": [
						{
							"key": "partner_name",
							"value": "{{PARTNER_NAME}}"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Validate API Key",
			"request": {
				"auth": {
					"type": "apikey",
					"apikey": [
						{
							"key": "value",
							"value": "{{API_KEY}}",
							"type": "string"
						},
						{
							"key": "key",
							"value": "X-API-Key",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/validate",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"validate"
					]
				}
			},
			"response": []
		},
		{
			"name": "Revoke API Key",
			"request": {
				"auth": {
					"type": "apikey",
					"apikey": [
						{
							"key": "value",
							"value": "{{API_KEY}}",
							"type": "string"
						},
						{
							"key": "key",
							"value": "X-API-Key",
							"type": "string"
						}
					]
				},
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/api-keys/{{KEY_ID}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"api-keys",
						"{{KEY_ID}}"
					]
				}
			},
			"response": []
		}
	]
}